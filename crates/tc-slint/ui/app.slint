import { Button, LineEdit, ScrollView, GroupBox, VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct UrlRow {
    code: string,
    code-color: color,
    url: string,
}

export struct WeatherRow {
    summary: string,
    emoji: string,
    description: string,
}

export struct Bar {
    level: float,
    color: color,
}

export component AppWindow inherits Window {
    title: "Tangential Cold — slint";
    preferred-width: 1100px;
    preferred-height: 720px;

    // --- Header ---
    in property <string> times-text;
    in property <string> center-text;
    in property <string> date-text;

    // --- URL status ---
    in property <[UrlRow]> url-rows;

    // --- System ---
    in property <string> cpu-count;
    in property <string> ram-total;
    in property <string> ram-used;
    in property <color> ram-used-color;
    in property <string> cpu-load;
    in property <color> cpu-load-color;

    // --- CPU history ---
    in property <[Bar]> cpu-bars;

    // --- Currency ---
    in property <string> currency-title;
    in-out property <string> currency-input-0;
    in-out property <string> currency-input-1;
    in property <string> currency-result-0;
    in property <string> currency-result-1;

    // --- Weather / GitHub ---
    in property <[WeatherRow]> weather-rows;
    in property <string> github-title;
    in property <string> github-emojis;

    // --- Footer ---
    in property <string> cfg-text;
    in property <color> cfg-color;

    callback refresh-clicked();
    callback currency-edited();

    VerticalBox {
        // Header
        HorizontalBox {
            Text { text: root.times-text; color: #4cccd9; vertical-alignment: center; }
            Text {
                text: root.center-text;
                color: #4cccd9;
                horizontal-alignment: center;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Text { text: root.date-text; color: #4cccd9; vertical-alignment: center; }
        }

        // Body
        ScrollView {
            HorizontalBox {
                alignment: start;

                // Left column
                VerticalBox {
                    horizontal-stretch: 1;

                    GroupBox {
                        title: "URL Status";
                        VerticalBox {
                            spacing: 2px;
                            padding: 0px;
                            alignment: start;
                            for row in root.url-rows : HorizontalBox {
                                spacing: 8px;
                                padding: 0px;
                                vertical-stretch: 0;
                                Text { text: row.code; color: row.code-color; min-width: 52px; horizontal-stretch: 0; }
                                Text { text: row.url; horizontal-stretch: 0; }
                            }
                        }
                    }

                    GroupBox {
                        title: "System";
                        VerticalBox {
                            spacing: 2px;
                            padding: 0px;
                            alignment: start;
                            HorizontalBox {
                                spacing: 8px;
                                padding: 0px;
                                vertical-stretch: 0;
                                Text { text: "CPU Count"; min-width: 96px; horizontal-stretch: 0; }
                                Text { text: root.cpu-count; horizontal-stretch: 0; }
                            }
                            HorizontalBox {
                                spacing: 8px;
                                padding: 0px;
                                vertical-stretch: 0;
                                Text { text: "RAM Total"; min-width: 96px; horizontal-stretch: 0; }
                                Text { text: root.ram-total; horizontal-stretch: 0; }
                            }
                            HorizontalBox {
                                spacing: 8px;
                                padding: 0px;
                                vertical-stretch: 0;
                                Text { text: "RAM Usage"; min-width: 96px; horizontal-stretch: 0; }
                                Text { text: root.ram-used; color: root.ram-used-color; horizontal-stretch: 0; }
                            }
                            HorizontalBox {
                                spacing: 8px;
                                padding: 0px;
                                vertical-stretch: 0;
                                Text { text: "CPU Load"; min-width: 96px; horizontal-stretch: 0; }
                                Text { text: root.cpu-load; color: root.cpu-load-color; horizontal-stretch: 0; }
                            }
                        }
                    }

                    GroupBox {
                        title: "CPU History";
                        Rectangle {
                            height: 48px;
                            HorizontalLayout {
                                alignment: start;
                                spacing: 1px;
                                for bar in root.cpu-bars : Rectangle {
                                    min-width: 6px;
                                    max-width: 6px;
                                    Rectangle {
                                        width: parent.width;
                                        height: parent.height * bar.level;
                                        y: parent.height - self.height;
                                        background: bar.color;
                                    }
                                }
                            }
                        }
                    }

                    GroupBox {
                        title: root.currency-title;
                        VerticalBox {
                            HorizontalBox {
                                LineEdit {
                                    text <=> root.currency-input-0;
                                    edited => { root.currency-edited(); }
                                    min-width: 120px;
                                }
                                Text { text: root.currency-result-0; vertical-alignment: center; }
                            }
                            HorizontalBox {
                                LineEdit {
                                    text <=> root.currency-input-1;
                                    edited => { root.currency-edited(); }
                                    min-width: 120px;
                                }
                                Text { text: root.currency-result-1; vertical-alignment: center; }
                            }
                        }
                    }
                }

                // Right column
                VerticalBox {
                    horizontal-stretch: 2;

                    GroupBox {
                        title: "Weather";
                        // Keep Latin text on the default font; emoji goes in its own
                        // Text with font-family "Noto Emoji" (registered from tc-core).
                        // Mixing both in one Text blanked the line after the emoji
                        // family was pointed at a Latin-less font.
                        VerticalBox {
                            spacing: 2px;
                            padding: 0px;
                            alignment: start;
                            for row in root.weather-rows : HorizontalBox {
                                spacing: 8px;
                                padding: 0px;
                                alignment: start;
                                vertical-stretch: 0;
                                Text {
                                    text: row.summary;
                                    vertical-stretch: 0;
                                    horizontal-stretch: 0;
                                }
                                if row.emoji != "" : Text {
                                    text: row.emoji;
                                    font-family: "Noto Emoji";
                                    // Cap emoji line-box so Noto metrics don't insert
                                    // a blank-looking gap between weather rows.
                                    height: 16px;
                                    vertical-alignment: center;
                                    vertical-stretch: 0;
                                    horizontal-stretch: 0;
                                }
                                if row.description != "" : Text {
                                    text: row.description;
                                    vertical-stretch: 0;
                                    horizontal-stretch: 0;
                                }
                            }
                        }
                    }

                    GroupBox {
                        title: root.github-title;
                        Text {
                            text: root.github-emojis;
                            font-family: "Noto Emoji";
                            wrap: no-wrap;
                        }
                    }

                    GroupBox {
                        title: "Tangential Cold";
                        Text {
                            text: "Tangential Cold";
                            color: #4cccd9;
                            horizontal-alignment: center;
                            font-size: 20px;
                        }
                    }
                }
            }
        }

        // Footer
        HorizontalBox {
            Button { text: "Refresh"; clicked => { root.refresh-clicked(); } }
            Rectangle { horizontal-stretch: 1; }
            Text { text: root.cfg-text; color: root.cfg-color; vertical-alignment: center; }
        }
    }
}
