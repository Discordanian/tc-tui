import { Button, LineEdit, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct UrlRow {
    code: string,
    code-color: color,
    url: string,
}

export struct WeatherRow {
    city: string,
    current: string,
    range: string,
    emoji: string,
    description: string,
}

export struct GhDay {
    emoji: string,
    color: color,
}

/// Bordered section matching iced/egui panels (1px border, 4px radius, cyan title).
component Panel inherits Rectangle {
    in property <string> title;
    border-width: 1px;
    border-color: #4d4d59;
    border-radius: 4px;
    background: transparent;
    vertical-stretch: 0;
    horizontal-stretch: 1;
    width: 100%;

    VerticalLayout {
        padding: 10px;
        spacing: 6px;

        Text {
            text: root.title;
            color: #4cccd9;
            font-size: 16px;
            font-weight: 700;
            vertical-stretch: 0;
        }

        @children
    }
}

export component AppWindow inherits Window {
    title: "Tangential Cold — slint";
    preferred-width: 1100px;
    preferred-height: 720px;

    // --- Header ---
    in property <string> times-text;
    in property <string> center-text;
    in property <string> date-text;

    // --- URL status ---
    in property <[UrlRow]> url-rows;

    // --- System ---
    in property <string> cpu-count;
    in property <string> ram-total;
    in property <string> ram-used;
    in property <color> ram-used-color;
    in property <string> cpu-load;
    in property <color> cpu-load-color;

    // --- CPU history wave (SVG path commands in a 100×48 viewbox) ---
    in property <string> cpu-wave-fill;
    in property <string> cpu-wave-line;
    in property <color> cpu-wave-color;
    in property <color> cpu-wave-fill-color;
    in property <bool> cpu-wave-collecting;

    // --- Currency ---
    in property <string> currency-title;
    in-out property <string> currency-input-0;
    in-out property <string> currency-input-1;
    in property <string> currency-result-0;
    in property <string> currency-result-1;

    // --- Weather / GitHub ---
    in property <[WeatherRow]> weather-rows;
    in property <string> github-title;
    in property <[GhDay]> github-days;

    // --- Footer ---
    in property <string> cfg-text;
    in property <color> cfg-color;

    callback refresh-clicked();
    callback currency-edited();

    VerticalBox {
        // Header
        HorizontalBox {
            Text { text: root.times-text; color: #4cccd9; vertical-alignment: center; }
            Text {
                text: root.center-text;
                color: #4cccd9;
                horizontal-alignment: center;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Text { text: root.date-text; color: #4cccd9; vertical-alignment: center; }
        }

        // Body — viewport matches the visible width so columns can stretch to
        // fill the window (ScrollView otherwise sizes to content min-width).
        ScrollView {
            viewport-width: self.visible-width;
            HorizontalBox {
                width: 100%;

                // Left column
                VerticalBox {
                    horizontal-stretch: 1;
                    padding: 0px;

                    Panel {
                        title: "URL Status";
                        VerticalBox {
                            spacing: 2px;
                            padding: 0px;
                            alignment: start;
                            for row in root.url-rows : HorizontalBox {
                                spacing: 8px;
                                padding: 0px;
                                vertical-stretch: 0;
                                Text {
                                    text: row.code;
                                    color: row.code-color;
                                    min-width: 52px;
                                    max-width: 52px;
                                    horizontal-stretch: 0;
                                    horizontal-alignment: left;
                                }
                                Text {
                                    text: row.url;
                                    horizontal-stretch: 1;
                                    horizontal-alignment: left;
                                }
                            }
                        }
                    }

                    Panel {
                        title: "System";
                        VerticalBox {
                            spacing: 2px;
                            padding: 0px;
                            alignment: start;
                            HorizontalBox {
                                spacing: 8px;
                                padding: 0px;
                                vertical-stretch: 0;
                                Text {
                                    text: "CPU Count";
                                    min-width: 96px;
                                    max-width: 96px;
                                    horizontal-stretch: 0;
                                    horizontal-alignment: left;
                                }
                                Text {
                                    text: root.cpu-count;
                                    horizontal-stretch: 1;
                                    horizontal-alignment: left;
                                }
                            }
                            HorizontalBox {
                                spacing: 8px;
                                padding: 0px;
                                vertical-stretch: 0;
                                Text {
                                    text: "RAM Total";
                                    min-width: 96px;
                                    max-width: 96px;
                                    horizontal-stretch: 0;
                                    horizontal-alignment: left;
                                }
                                Text {
                                    text: root.ram-total;
                                    horizontal-stretch: 1;
                                    horizontal-alignment: left;
                                }
                            }
                            HorizontalBox {
                                spacing: 8px;
                                padding: 0px;
                                vertical-stretch: 0;
                                Text {
                                    text: "RAM Usage";
                                    min-width: 96px;
                                    max-width: 96px;
                                    horizontal-stretch: 0;
                                    horizontal-alignment: left;
                                }
                                Text {
                                    text: root.ram-used;
                                    color: root.ram-used-color;
                                    horizontal-stretch: 1;
                                    horizontal-alignment: left;
                                }
                            }
                            HorizontalBox {
                                spacing: 8px;
                                padding: 0px;
                                vertical-stretch: 0;
                                Text {
                                    text: "CPU Load";
                                    min-width: 96px;
                                    max-width: 96px;
                                    horizontal-stretch: 0;
                                    horizontal-alignment: left;
                                }
                                Text {
                                    text: root.cpu-load;
                                    color: root.cpu-load-color;
                                    horizontal-stretch: 1;
                                    horizontal-alignment: left;
                                }
                            }
                        }
                    }

                    Panel {
                        title: "CPU History";
                        Rectangle {
                            height: 48px;
                            // Faint baseline
                            Path {
                                width: parent.width;
                                height: parent.height;
                                viewbox-width: 100;
                                viewbox-height: 48;
                                commands: "M 0 48 L 100 48";
                                stroke: #464646;
                                stroke-width: 1px;
                            }
                            // Filled area under the smoothed curve
                            Path {
                                width: parent.width;
                                height: parent.height;
                                viewbox-width: 100;
                                viewbox-height: 48;
                                commands: root.cpu-wave-fill;
                                fill: root.cpu-wave-fill-color;
                            }
                            // Stroke along the curve
                            Path {
                                width: parent.width;
                                height: parent.height;
                                viewbox-width: 100;
                                viewbox-height: 48;
                                commands: root.cpu-wave-line;
                                stroke: root.cpu-wave-color;
                                stroke-width: 1.5px;
                            }
                            if root.cpu-wave-collecting : Text {
                                width: parent.width;
                                height: parent.height;
                                text: "collecting…";
                                color: #8c8c8c;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Panel {
                        title: root.currency-title;
                        VerticalBox {
                            padding: 0px;
                            spacing: 6px;
                            HorizontalBox {
                                padding: 0px;
                                spacing: 8px;
                                LineEdit {
                                    text <=> root.currency-input-0;
                                    edited => { root.currency-edited(); }
                                    min-width: 120px;
                                }
                                Text { text: root.currency-result-0; vertical-alignment: center; }
                            }
                            HorizontalBox {
                                padding: 0px;
                                spacing: 8px;
                                LineEdit {
                                    text <=> root.currency-input-1;
                                    edited => { root.currency-edited(); }
                                    min-width: 120px;
                                }
                                Text { text: root.currency-result-1; vertical-alignment: center; }
                            }
                        }
                    }
                }

                // Right column
                VerticalBox {
                    horizontal-stretch: 2;
                    padding: 0px;

                    Panel {
                        title: "Weather";
                        // Fixed-width columns so rows line up. Emoji stays on its
                        // own Text with font-family "Noto Emoji" (from tc-core).
                        VerticalBox {
                            spacing: 2px;
                            padding: 0px;
                            alignment: start;
                            for row in root.weather-rows : HorizontalBox {
                                spacing: 8px;
                                padding: 0px;
                                alignment: start;
                                vertical-stretch: 0;
                                Text {
                                    text: row.city;
                                    min-width: 110px;
                                    max-width: 110px;
                                    overflow: elide;
                                    vertical-stretch: 0;
                                    horizontal-stretch: 0;
                                }
                                Text {
                                    text: row.current;
                                    min-width: 130px;
                                    max-width: 130px;
                                    vertical-stretch: 0;
                                    horizontal-stretch: 0;
                                }
                                Text {
                                    text: row.range;
                                    min-width: 140px;
                                    max-width: 140px;
                                    vertical-stretch: 0;
                                    horizontal-stretch: 0;
                                }
                                Text {
                                    text: row.emoji;
                                    font-family: "Noto Emoji";
                                    min-width: 20px;
                                    max-width: 20px;
                                    height: 16px;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                    vertical-stretch: 0;
                                    horizontal-stretch: 0;
                                }
                                Text {
                                    text: row.description;
                                    vertical-stretch: 0;
                                    horizontal-stretch: 0;
                                }
                            }
                        }
                    }

                    Panel {
                        title: root.github-title;
                        // Newest-first days; Rust trims oldest that don't fit.
                        HorizontalBox {
                            spacing: 4px;
                            padding: 0px;
                            alignment: start;
                            for day in root.github-days : Text {
                                text: day.emoji;
                                color: day.color;
                                font-family: "Noto Emoji";
                                vertical-stretch: 0;
                                horizontal-stretch: 0;
                            }
                        }
                    }

                    Panel {
                        title: "Tangential Cold";
                        Text {
                            text: "Tangential Cold";
                            color: #4cccd9;
                            horizontal-alignment: center;
                            font-size: 20px;
                            width: 100%;
                        }
                    }
                }
            }
        }

        // Footer
        HorizontalBox {
            Button { text: "Refresh"; clicked => { root.refresh-clicked(); } }
            Rectangle { horizontal-stretch: 1; }
            Text { text: root.cfg-text; color: root.cfg-color; vertical-alignment: center; }
        }
    }
}
